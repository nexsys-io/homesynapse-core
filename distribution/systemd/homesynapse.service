[Unit]
# HomeSynapse Core — Tier-1 systemd service unit.
#
# Boots the CURRENT artifact (core 5363347, M7.3) as a least-privilege,
# loopback-bound, authenticated service. Paths mirror distribution/common.sh and
# the Locked boot contract (Doc 12 §3.2 / LTD-01 / LTD-13).
#
# READINESS TODAY: real sd_notify is deferred (OR-M13-SDNOTIFY, held) — OpenJDK 21
# has no AF_UNIX SOCK_DGRAM (JEP 380 is stream-only), so SystemdHealthReporter
# throws and NoOpHealthReporter is the live path. Therefore this unit is Type=exec
# and proves readiness with the UNauthenticated loopback /health probe in
# ExecStartPost (E3 closed at R-9). The Type=notify + WatchdogSec block at the
# bottom is NOT a staged flip — read its DANGER note before touching it.
Description=HomeSynapse Core — local-first smart-home engine
Documentation=file:/opt/homesynapse/VERSION
After=network-online.target
Wants=network-online.target
# Bound the crash-loop: at most 5 starts per 5 min, else stop trying (and surface).
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=homesynapse
Group=homesynapse

# systemd creates + owns these (FHS); StateDirectory=homesynapse → /var/lib/homesynapse.
# Mode 0700 because the event store and the first-run pairing token live here.
StateDirectory=homesynapse
StateDirectoryMode=0700
LogDirectory=homesynapse
ConfigurationDirectory=homesynapse
ConfigurationDirectoryMode=0750
WorkingDirectory=/var/lib/homesynapse

# CURRENT-ARTIFACT path model: Main resolves every runtime dir from
# $HOMESYNAPSE_HOME (it does not yet select LinuxSystemPaths — see
# docs/boot-contract-map.md). Drop this line when the composition root wires
# LinuxSystemPaths (M13); the FHS split takes over with no other unit change.
Environment=HOMESYNAPSE_HOME=/var/lib/homesynapse
# Operator overrides (HOMESYNAPSE_JVM_OPTS, future LAN opt-in). Optional ("-").
EnvironmentFile=-/etc/homesynapse/homesynapse.env

ExecStart=/opt/homesynapse/bin/homesynapse

# Readiness gate: block `systemctl start` until the loopback /health answers ready.
# The probe hits the UNauthenticated loopback /health (E3 closed at R-9): HTTP 200 =
# ready (the state projection is LIVE), 503 = up-but-not-ready (keep waiting),
# conn-refused = not up yet; a 401/403 on /health is a start FAILURE (exit 3), never
# a silent pass. The first-run token is NOT read by the unit — the pairing artifact
# may be deleted after pairing without affecting any restart. If readiness never
# arrives, the unit fails and Restart= kicks in.
ExecStartPost=/opt/homesynapse/libexec/health-probe.sh --wait --timeout 90 --health-path /health

# Graceful stop: Main installs a SIGTERM shutdown hook (Doc 12 §7, 30s internal
# grace). Give systemd's stop timeout the Doc-12 budget.
KillSignal=SIGTERM
TimeoutStartSec=120
TimeoutStopSec=90

# Restart policy keyed to the ExitCode contract. CONFIGURATION_FAILURE (10) is
# deterministic — a bad config will fail identically on every restart, so do NOT
# loop on it; surface it instead. All other non-zero exits are restart-worthy.
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=10

# Resource ceiling (Doc 12 §6.6).
MemoryMax=2G

# ── Least-privilege hardening ───────────────────────────────────────────────
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
# AF_UNIX is kept for the M13 sd_notify socket; AF_INET/6 for the loopback HTTP surface.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# RAMP (post-M9): the Zigbee coordinator is a serial device. PrivateDevices=yes
# blocks /dev access, so loosen it then and allowlist the coordinator, e.g.:
#   PrivateDevices=no
#   DeviceAllow=/dev/ttyUSB0 rw
#   SupplementaryGroups=dialout
PrivateDevices=yes

# Journald capture (Console output is plain text per Doc 12 §0.3).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=homesynapse

# ── DANGER — do NOT flip to Type=notify (OR-M13-SDNOTIFY is HELD) ────────────
# The sd_notify shape below is kept ONLY as a record of the eventual unit; it is
# NOT a two-line edit. Enabling it today BRICKS the service: Type=notify makes
# systemd set $NOTIFY_SOCKET, the composition root then constructs
# SystemdHealthReporter, whose transport ctor throws on OpenJDK 21 (no AF_UNIX
# SOCK_DGRAM), and the catch degrades to NoOpHealthReporter — so READY=1 is NEVER
# sent: systemd holds the unit `activating` until TimeoutStartSec=120, fails it,
# Restart=on-failure retries, and StartLimitBurst=5 per 300 s lands it
# start-limited DOWN in roughly ten minutes. WatchdogSec=60 independently SIGABRTs
# the process at 60 s (no WATCHDOG=1 ever arrives). Precondition: a WORKING
# sd_notify transport in platform-systemd, proven on the target JDK — until then
# Type=notify / WatchdogSec= brick the unit. Source: nexsys-hivemind
# context/audits/2026-08-22_R10-IN-L_liveness-and-notify-transport_return.md §3 f1.
# The eventual shape, inert while commented:
#   Type=notify             ; replaces Type=exec — READY=1 then gates the start
#   NotifyAccess=main
#   WatchdogSec=60          ; C12-03 liveness — health loop pets WATCHDOG=1 at 30s
#   Restart=on-watchdog
# The ExecStartPost /health probe stays correct regardless and remains the smoke's
# instrument. Map: distribution/docs/boot-contract-map.md.

[Install]
WantedBy=multi-user.target

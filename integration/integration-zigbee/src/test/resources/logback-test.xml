<?xml version="1.0" encoding="UTF-8"?>
<!-- Test-tree logback (rides in with the M9.4b F-12 WARN-capture dependency): root INFO mirrors the app default so DEBUG-heavy codec/protocol paths stay quiet under test. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

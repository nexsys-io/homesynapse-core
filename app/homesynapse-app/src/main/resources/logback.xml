<?xml version="1.0" encoding="UTF-8"?>
<!-- Root INFO is a security default: Jetty/HTTP DEBUG echoes bearer credentials (FE-1b 2026-07-03); raise per-logger at runtime via the future LogLevelController, not by editing this default. -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

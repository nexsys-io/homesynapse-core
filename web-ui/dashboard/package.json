{
  "name": "@homesynapse/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HomeSynapse Core — V1 Observability Dashboard (Preact SPA, static, <100KB gzip, served from Javalin)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "prebuild": "npm run tokens",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:contract": "node scripts/contract-check.mjs",
    "verify": "npm run tokens:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check:bundle && npm run check:contract"
  },
  "dependencies": {
    "preact": "^10.22.1",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@preact/preset-vite": "^2.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^20.14.10",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "jsdom": "^24.1.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.5"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}
